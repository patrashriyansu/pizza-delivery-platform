NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/slicehouse?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Email (optional for local development; links are logged if SMTP is missing)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SliceHouse <no-reply@example.com>
ADMIN_ALERT_EMAIL=admin@example.com

# Razorpay TEST keys only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

ADMIN_NAME=SliceHouse Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
